<?xml version="1.0" encoding="utf-8"?>
<!-- NuGet 配置：CI 与本机共用，保证 Esri.ArcGISPro.Extensions30 包源一致。
     - nuget.org：Esri 官方包与第三方依赖（ClosedXML 等）均在此发布
     - 清除机器级配置干扰：CI 的 windows-latest 默认源即 nuget.org，
       这里显式声明，避免不同机器全局配置差异导致 CI 还原失败 -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
