<controls:ProWindow x:Class="GHBoxAddIn.Scripts.Help.CheckUpdate"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
        mc:Ignorable="d"
        Title="检查更新" Height="340" Width="460" MinHeight="300" MinWidth="400"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <controls:ProWindow.Resources>
        <ResourceDictionary Source="pack://application:,,,/GHBoxAddIn;component/Scripts/GDB/Themes/GhBoxStyles.xaml" />
    </controls:ProWindow.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 状态提示（检查中 / 已是最新 / 发现新版本） -->
        <TextBlock x:Name="TextStatus" Grid.Row="0" Style="{StaticResource GhTitleText}"
                   Text="正在检查更新…" />

        <!-- 版本信息 -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Style="{StaticResource GhLabel}"
                       Text="当前版本：" Margin="0,0,0,4" />
            <TextBlock x:Name="TextCurrentVersion" Style="{StaticResource GhHintText}" />
            <TextBlock Style="{StaticResource GhLabel}"
                       Text="GitHub 最新版本：" Margin="0,10,0,4" />
            <TextBlock x:Name="TextLatestVersion" Style="{StaticResource GhHintText}" />
        </StackPanel>

        <!-- 结果说明（发现新版本时的引导文案） -->
        <Border Grid.Row="2" x:Name="BoxHint" Style="{StaticResource GhHintBorder}" Margin="0,14,0,0"
                Visibility="Collapsed">
            <TextBlock x:Name="TextHint" Style="{StaticResource GhHintText}" TextWrapping="Wrap" />
        </Border>

        <!-- 日志（占位，报错信息在此回显，保证布局稳定） -->
        <TextBox x:Name="TextLog" Grid.Row="3" Style="{StaticResource GhLogBox}" Margin="0,14,0,0" />

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnCheck" Content="重新检查" Style="{StaticResource GhGhostButton}" Margin="0,0,8,0"
                    Click="CheckButton_Click" />
            <Button x:Name="BtnDownload" Content="前往 GitHub 下载" Style="{StaticResource GhPrimaryButton}"
                    IsEnabled="False" Click="DownloadButton_Click" />
        </StackPanel>
    </Grid>
</controls:ProWindow>