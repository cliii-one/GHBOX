<controls:ProWindow x:Class="GHBoxAddIn.Scripts.GDB.AreaCalc"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
        mc:Ignorable="d"
        Title="面积重算" Height="600" Width="680"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <controls:ProWindow.Resources>
        <ResourceDictionary Source="pack://application:,,,/GHBoxAddIn;component/Scripts/GDB/Themes/GhBoxStyles.xaml" />
    </controls:ProWindow.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 输入数据库 -->
        <TextBlock Grid.Row="0" Style="{StaticResource GhLabel}"
                   Text="输入数据库（.gdb，选择图层与面积字段）：" Margin="0,0,0,4" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TextInputGdb" Style="{StaticResource GhTextBox}" />
            <Button Grid.Column="1" Content="浏览..." Style="{StaticResource GhGhostButton}"
                    Margin="6,0,0,0" Click="BrowseInput_Click" />
        </Grid>

        <!-- 图层多选 + 面积字段 -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource GhLabel}"
                       Text="选择图层（可多选，Ctrl/Shift 批量选择）：" Margin="0,0,0,4" />
            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource GhLabel}"
                       Text="面积字段（只列双精度/浮点字段）：" Margin="0,0,0,4" />
            <ListBox Grid.Row="1" Grid.Column="0" x:Name="ListLayers" Height="120"
                     Style="{StaticResource GhListBox}"
                     SelectionMode="Extended"
                     SelectionChanged="ListLayers_SelectionChanged" />
            <ComboBox Grid.Row="1" Grid.Column="2" x:Name="ComboField" Width="200"
                      Style="{StaticResource GhComboBox}"
                      SelectionChanged="ComboField_SelectionChanged" />
        </Grid>

        <!-- 面积单位 + 小数位（默认项在 Loaded 里代码设置，规避 XAML 默认值提前触发事件的问题） -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource GhLabel}" Text="面积单位：" />
            <ComboBox Grid.Column="1" x:Name="ComboUnit" Style="{StaticResource GhComboBox}"
                      SelectionChanged="ComboUnit_SelectionChanged" />
            <TextBlock Grid.Column="2" Style="{StaticResource GhLabel}" Text="小数位数：" Margin="16,0,0,0" />
            <ComboBox Grid.Column="3" x:Name="ComboDigits" Style="{StaticResource GhComboBox}"
                      ToolTip="对计算结果四舍五入保留小数位；默认不保留写入原始值" />
            <TextBlock Grid.Column="4" Style="{StaticResource GhHintText}" Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Text="椭球面积（测地线）· 1 公顷 = 10000 m²；1 亩 = 2000/3 m²" />
        </Grid>

        <!-- 进度与日志 -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ProgressBar x:Name="Progress" Style="{StaticResource GhProgress}" Minimum="0" Maximum="100" />
            <TextBox x:Name="TextLog" Grid.Row="1" Style="{StaticResource GhLogBox}" Margin="0,8,0,0" />
        </Grid>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnHelp" Content="使用说明" Style="{StaticResource GhGhostButton}" Margin="0,0,8,0"
                    Click="HelpButton_Click" />
            <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource GhGhostButton}" Margin="0,0,8,0"
                    IsEnabled="False" Click="CancelButton_Click" />
            <Button x:Name="BtnRun" Content="开始计算" Style="{StaticResource GhPrimaryButton}"
                    Click="RunButton_Click" />
        </StackPanel>
    </Grid>
</controls:ProWindow>
