<controls:ProWindow x:Class="GHBoxAddIn.Scripts.GDB.AttributeExport"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
        mc:Ignorable="d"
        Title="按属性拆库" Height="540" Width="640"
        WindowStartupLocation="CenterScreen">
    <controls:ProWindow.Resources>
        <ResourceDictionary Source="pack://application:,,,/GHBoxAddIn;component/Scripts/GDB/Themes/GhBoxStyles.xaml" />
    </controls:ProWindow.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 输入文件夹 -->
        <TextBlock Grid.Row="0" Style="{StaticResource GhLabel}" Text="输入文件夹（包含多个 GDB/MDB）：" Margin="0,0,0,4" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TextFolderPath" Style="{StaticResource GhTextBox}" />
            <Button Grid.Column="1" Content="浏览..." Style="{StaticResource GhGhostButton}"
                    Margin="6,0,0,0" Click="BrowseFolderButton_Click" />
        </Grid>

        <!-- 图层名称 -->
        <TextBlock Grid.Row="2" Style="{StaticResource GhLabel}" Text="图层名称：" Margin="0,10,0,4" />
        <TextBox Grid.Row="3" x:Name="TextLayerName" Style="{StaticResource GhTextBox}" />

        <!-- 筛选条件（可选） -->
        <TextBlock Grid.Row="4" Style="{StaticResource GhLabel}" Text="筛选条件（可选，SQL 语句，留空表示整层导出）：" Margin="0,10,0,4" />
        <TextBox Grid.Row="5" x:Name="TextWhereClause" Style="{StaticResource GhTextBox}" />

        <!-- 输出文件夹 -->
        <TextBlock Grid.Row="6" Style="{StaticResource GhLabel}" Text="输出文件夹（不存在时自动创建）：" Margin="0,10,0,4" />
        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TextOutputFolder" Style="{StaticResource GhTextBox}" />
            <Button Grid.Column="1" Content="浏览..." Style="{StaticResource GhGhostButton}"
                    Margin="6,0,0,0" Click="BrowseOutputButton_Click" />
        </Grid>

        <!-- 导出为GDB -->
        <CheckBox Grid.Row="8" x:Name="CheckExportToGdb" Content="导出为GDB（默认导出为SHP）" Margin="0,10,0,0" />

        <!-- 进度与日志 -->
        <Grid Grid.Row="9" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ProgressBar x:Name="Progress" Style="{StaticResource GhProgress}" Minimum="0" Maximum="100" />
            <TextBox x:Name="TextLog" Grid.Row="1" Style="{StaticResource GhLogBox}" Margin="0,8,0,0" />
        </Grid>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnHelp" Content="使用说明" Style="{StaticResource GhGhostButton}" Margin="0,0,8,0"
                    Click="HelpButton_Click" />
            <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource GhGhostButton}" Margin="0,0,8,0"
                    IsEnabled="False" Click="CancelButton_Click" />
            <Button x:Name="BtnRun" Content="开始导出" Style="{StaticResource GhPrimaryButton}"
                    Click="RunButton_Click" />
        </StackPanel>
    </Grid>
</controls:ProWindow>
