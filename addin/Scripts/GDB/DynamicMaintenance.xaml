<controls:ProWindow x:Class="GHBoxAddIn.Scripts.GDB.DynamicMaintenance"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
        mc:Ignorable="d"
        Title="动态维护" Height="620" Width="700"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <controls:ProWindow.Resources>
        <ResourceDictionary Source="pack://application:,,,/GHBoxAddIn;component/Scripts/GDB/Themes/GhBoxStyles.xaml" />
    </controls:ProWindow.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 备案数据库A -->
        <TextBlock Grid.Row="0" Style="{StaticResource GhLabel}" Text="备案数据库A（部备案版本）：" Margin="0,0,0,4" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TextDbA" Style="{StaticResource GhTextBox}" />
            <Button Grid.Column="1" Content="浏览..." Style="{StaticResource GhGhostButton}"
                    Margin="6,0,0,0" Click="BrowseDbA_Click" />
        </Grid>

        <!-- 维护后全量数据库B -->
        <TextBlock Grid.Row="2" Style="{StaticResource GhLabel}" Text="维护后全量数据库B：" Margin="0,10,0,4" />
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TextDbB" Style="{StaticResource GhTextBox}" />
            <Button Grid.Column="1" Content="浏览..." Style="{StaticResource GhGhostButton}"
                    Margin="6,0,0,0" Click="BrowseDbB_Click" />
        </Grid>

        <!-- 输出目录 -->
        <TextBlock Grid.Row="4" Style="{StaticResource GhLabel}" Text="动态维护数据库C存放目录：" Margin="0,10,0,4" />
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TextOutputFolder" Style="{StaticResource GhTextBox}" />
            <Button Grid.Column="1" Content="浏览..." Style="{StaticResource GhGhostButton}"
                    Margin="6,0,0,0" Click="BrowseOutputFolder_Click" />
        </Grid>

        <!-- 选择需维护图层 + 行政区信息 -->
        <Grid Grid.Row="6" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：图层选择 -->
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource GhLabel}" Text="选择需维护图层（可多选）：" />
                    <TextBlock x:Name="TextSelCount" Style="{StaticResource GhSelCountBadge}" Text="已选择 0 个图层" />
                </StackPanel>
                <ListBox x:Name="ListLayers" Height="120"
                         Style="{StaticResource GhListBox}" SelectionMode="Extended"
                         SelectionChanged="ListLayers_SelectionChanged" />
            </StackPanel>

            <!-- 右侧：行政区信息 -->
            <StackPanel Grid.Column="2" Margin="0,0,0,0">
                <TextBlock Style="{StaticResource GhLabel}" Text="行政区代码：" Margin="0,0,0,2" />
                <TextBox x:Name="TextXzqdm" Style="{StaticResource GhTextBox}"
                         ToolTip="如 420100" Margin="0,0,0,10" />
                <TextBlock Style="{StaticResource GhLabel}" Text="行政区名称：" Margin="0,0,0,2" />
                <TextBox x:Name="TextXzqmc" Style="{StaticResource GhTextBox}"
                         ToolTip="如 黄石市" Margin="0,0,0,10" />
                <TextBlock Style="{StaticResource GhLabel}" Text="维护年度：" Margin="0,0,0,2" />
                <TextBox x:Name="TextYear" Style="{StaticResource GhTextBox}"
                         Text="2026" ToolTip="如 2026" />
            </StackPanel>
        </Grid>

        <!-- 进度与日志 -->
        <Grid Grid.Row="8" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ProgressBar x:Name="Progress" Style="{StaticResource GhProgress}" Minimum="0" Maximum="100" />
            <TextBox x:Name="TextLog" Grid.Row="1" Style="{StaticResource GhLogBox}" Margin="0,8,0,0" />
        </Grid>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnHelp" Content="使用说明" Style="{StaticResource GhGhostButton}" Margin="0,0,8,0"
                    Click="HelpButton_Click" />
            <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource GhGhostButton}" Margin="0,0,8,0"
                    IsEnabled="False" Click="CancelButton_Click" />
            <Button x:Name="BtnRun" Content="开始维护" Style="{StaticResource GhPrimaryButton}"
                    Click="RunButton_Click" />
        </StackPanel>
    </Grid>
</controls:ProWindow>
