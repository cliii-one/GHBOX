<controls:ProWindow x:Class="GHBoxAddIn.Scripts.GDB.LayerMerge"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
        mc:Ignorable="d"
        Title="数据库合并" Height="500" Width="640"
        WindowStartupLocation="CenterScreen">
    <controls:ProWindow.Resources>
        <ResourceDictionary Source="pack://application:,,,/GHBoxAddIn;component/Scripts/GDB/Themes/GhBoxStyles.xaml" />
    </controls:ProWindow.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 输入文件夹 -->
        <TextBlock Grid.Row="0" Style="{StaticResource GhLabel}" Text="需要合并的文件夹：" Margin="0,0,0,4" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TextFolderPath" Style="{StaticResource GhTextBox}" />
            <Button Grid.Column="1" Content="浏览..." Style="{StaticResource GhGhostButton}"
                    Margin="6,0,0,0" Click="BrowseFolderButton_Click" />
        </Grid>

        <!-- 输出数据库（必须已存在，浏览选择） -->
        <TextBlock Grid.Row="2" Style="{StaticResource GhLabel}" Text="输出数据库（已存在的 GDB/MDB）：" Margin="0,10,0,4" />
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TextOutputWorkspace" Style="{StaticResource GhTextBox}" />
            <Button Grid.Column="1" Content="浏览..." Style="{StaticResource GhGhostButton}"
                    Margin="6,0,0,0" Click="BrowseOutputButton_Click" />
        </Grid>

        <!-- 图层名称（逗号分隔或 ALL） -->
        <TextBlock Grid.Row="4" Style="{StaticResource GhLabel}"
                   Text="需要合并的图层（多个用英文逗号分隔，或输入 ALL 表示全部）：" Margin="0,10,0,4" />
        <TextBox Grid.Row="5" x:Name="TextLayerNames" Style="{StaticResource GhTextBox}" />

        <!-- 进度与日志 -->
        <Grid Grid.Row="6" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ProgressBar x:Name="Progress" Style="{StaticResource GhProgress}" Minimum="0" Maximum="100" />
            <TextBox x:Name="TextLog" Grid.Row="1" Style="{StaticResource GhLogBox}" Margin="0,8,0,0" />
        </Grid>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnHelp" Content="使用说明" Style="{StaticResource GhGhostButton}" Margin="0,0,8,0"
                    Click="HelpButton_Click" />
            <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource GhGhostButton}" Margin="0,0,8,0"
                    IsEnabled="False" Click="CancelButton_Click" />
            <Button x:Name="BtnRun" Content="开始合并" Style="{StaticResource GhPrimaryButton}"
                    Click="RunButton_Click" />
        </StackPanel>
    </Grid>
</controls:ProWindow>
