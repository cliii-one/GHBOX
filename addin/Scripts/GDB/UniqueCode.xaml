<controls:ProWindow x:Class="GHBoxAddIn.Scripts.GDB.UniqueCode"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
        mc:Ignorable="d"
        Title="唯一编码" Height="600" Width="680"
        WindowStartupLocation="CenterScreen">
    <controls:ProWindow.Resources>
        <ResourceDictionary Source="pack://application:,,,/GHBoxAddIn;component/Scripts/GDB/Themes/GhBoxStyles.xaml" />
    </controls:ProWindow.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 输入数据库 -->
        <TextBlock Grid.Row="0" Style="{StaticResource GhLabel}" Text="输入数据库（.gdb，选择图层与编码字段）：" Margin="0,0,0,4" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TextInputGdb" Style="{StaticResource GhTextBox}" />
            <Button Grid.Column="1" Content="浏览..." Style="{StaticResource GhGhostButton}"
                    Margin="6,0,0,0" Click="BrowseInput_Click" />
        </Grid>

        <!-- 图层多选 + 编码字段 -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Style="{StaticResource GhLabel}"
                           Text="选择图层（可多选，Ctrl/Shift 批量）：" />
                <TextBlock x:Name="TextSelCount" Style="{StaticResource GhSelCountBadge}"
                           Text="已选择 0 个图层" />
            </StackPanel>
            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource GhLabel}"
                       Text="编码字段（公共可写字段）：" Margin="0,0,0,4" VerticalAlignment="Center" />
            <ListBox Grid.Row="1" Grid.Column="0" x:Name="ListLayers" Height="120"
                     Style="{StaticResource GhListBox}"
                     SelectionMode="Extended"
                     SelectionChanged="ListLayers_SelectionChanged" />
            <ComboBox Grid.Row="1" Grid.Column="2" x:Name="ComboField" Width="210"
                      Style="{StaticResource GhComboBox}"
                      SelectionChanged="ComboField_SelectionChanged" />
        </Grid>

        <!-- 编码参数 -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="70" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource GhLabel}" Text="编码长度：" />
            <TextBox Grid.Column="1" x:Name="TextCodeLength" Text="18" Style="{StaticResource GhTextBox}"
                     TextChanged="Param_TextChanged" />
            <TextBlock Grid.Column="2" Style="{StaticResource GhLabel}" Text="编码开头：" Margin="16,0,6,0" />
            <TextBox Grid.Column="3" x:Name="TextCodePrefix" Style="{StaticResource GhTextBox}"
                     TextChanged="Param_TextChanged"
                     ToolTip="如 4201232026；序号 = 编码长度 - 开头长度，左补零" />
            <TextBlock Grid.Column="4" Style="{StaticResource GhLabel}" Text="编码起始值：" Margin="16,0,6,0" />
            <TextBox Grid.Column="5" x:Name="TextStartValue" Text="1" Style="{StaticResource GhTextBox}"
                     TextChanged="Param_TextChanged" />
        </Grid>

        <!-- 编号方式 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
            <RadioButton x:Name="RadioPerLayer" Content="每图层独立编号（各图层都从起始值开始）" IsChecked="True"
                         Margin="0,0,16,0" Checked="RadioMode_Changed"
                         Foreground="{DynamicResource Esri_TextControlBrush}" />
            <RadioButton x:Name="RadioContinuous" Content="跨图层连续编号（所有图层间连续递增）"
                         Checked="RadioMode_Changed"
                         Foreground="{DynamicResource Esri_TextControlBrush}" />
        </StackPanel>

        <!-- 首码预览 -->
        <Border Grid.Row="5" Style="{StaticResource GhHintBorder}" Margin="0,10,0,0">
            <TextBlock x:Name="TextPreview" Style="{StaticResource GhHintText}"
                       Text="示例：长度 18、开头 4201232026、起始值 100 → 首码 420123202600000100" />
        </Border>

        <!-- 进度与日志 -->
        <Grid Grid.Row="6" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ProgressBar x:Name="Progress" Style="{StaticResource GhProgress}" Minimum="0" Maximum="100" />
            <TextBox x:Name="TextLog" Grid.Row="1" Style="{StaticResource GhLogBox}" Margin="0,8,0,0" />
        </Grid>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnHelp" Content="使用说明" Style="{StaticResource GhGhostButton}" Margin="0,0,8,0"
                    Click="HelpButton_Click" />
            <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource GhGhostButton}" Margin="0,0,8,0"
                    IsEnabled="False" Click="CancelButton_Click" />
            <Button x:Name="BtnRun" Content="开始编码" Style="{StaticResource GhPrimaryButton}"
                    Click="RunButton_Click" />
        </StackPanel>
    </Grid>
</controls:ProWindow>
