<controls:ProWindow x:Class="GHBoxAddIn.Scripts.Check.FindAngle"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
        mc:Ignorable="d"
        Title="查找尖锐角" Height="600" Width="640"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height" MaxHeight="760">
    <controls:ProWindow.Resources>
        <ResourceDictionary Source="pack://application:,,,/GHBoxAddIn;component/Scripts/GDB/Themes/GhBoxStyles.xaml" />
    </controls:ProWindow.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 输入数据库 -->
        <TextBlock Grid.Row="0" Style="{StaticResource GhLabel}"
                   Text="输入数据库（.gdb，选择要检查的图层）：" Margin="0,0,0,4" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TextInputGdb" Style="{StaticResource GhTextBox}" />
            <Button Grid.Column="1" Content="浏览..." Style="{StaticResource GhGhostButton}"
                    Margin="6,0,0,0" Click="BrowseInput_Click" />
        </Grid>

        <!-- 图层多选 -->
        <TextBlock Grid.Row="2" Style="{StaticResource GhLabel}"
                   Text="选择图层（可多选，Ctrl/Shift 批量检查）：" Margin="0,10,0,4" />
        <ListBox Grid.Row="3" x:Name="ListLayers" Height="100"
                 Style="{StaticResource GhListBox}" SelectionMode="Extended" />

        <!-- 角度阈值 -->
        <TextBlock Grid.Row="4" Style="{StaticResource GhLabel}"
                   Text="角度阈值（度，顶点内角小于该值即命中）：" Margin="0,10,0,4" />
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TextAngle" Style="{StaticResource GhTextBox}" TextChanged="TextAngle_TextChanged" />
            <TextBlock Grid.Column="1" x:Name="TextHint" Style="{StaticResource GhHintText}"
                       Margin="16,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
        </Grid>

        <!-- 输出库 -->
        <TextBlock Grid.Row="6" Style="{StaticResource GhLabel}"
                   Text="结果输出数据库（已存在的 .gdb；留空则仅统计不落库）：" Margin="0,10,0,4" />
        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TextOutputGdb" Style="{StaticResource GhTextBox}" />
            <Button Grid.Column="1" Content="浏览..." Style="{StaticResource GhGhostButton}"
                    Margin="6,0,0,0" Click="BrowseOutput_Click" />
        </Grid>

        <!-- 进度与日志 -->
        <Grid Grid.Row="8" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="90" />
            </Grid.RowDefinitions>
            <ProgressBar x:Name="Progress" Style="{StaticResource GhProgress}" Minimum="0" Maximum="100" />
            <TextBox x:Name="TextLog" Grid.Row="1" Style="{StaticResource GhLogBox}" Margin="0,8,0,0" />
        </Grid>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnHelp" Content="使用说明" Style="{StaticResource GhGhostButton}" Margin="0,0,8,0"
                    Click="HelpButton_Click" />
            <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource GhGhostButton}" Margin="0,0,8,0"
                    IsEnabled="False" Click="CancelButton_Click" />
            <Button x:Name="BtnRun" Content="开始检查" Style="{StaticResource GhPrimaryButton}"
                    Click="RunButton_Click" />
        </StackPanel>
    </Grid>
</controls:ProWindow>
